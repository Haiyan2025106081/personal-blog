---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="技能与技术栈" description="研究方向、技术工具、内容领域与一句话简介。">
  <div class="container page-title">
    <h1>技能与技术栈</h1>
    <p>研究方向、技术工具与内容领域的简明说明。</p>
  </div>

  <section class="section section--soft">
    <div class="container">
      <div class="category-strip">
        <div class="category-card">
          <h3>研究方向</h3>
          <p>网络与新媒体（智能传播）</p>
        </div>
        <div class="category-card">
          <h3>技术工具</h3>
          <p>WorkBuddy、GitHub Pages、Astro、Figma、剪映</p>
        </div>
        <div class="category-card">
          <h3>内容领域</h3>
          <p>AI 自动化视频生成、新媒体交互设计、Cosplay视觉创作</p>
        </div>
        <div class="category-card">
          <h3>一句话简介</h3>
          <p>西北大学新传在读，关注技术如何重塑内容生产与传播。</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
